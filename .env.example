# Flask application settings
FLASK_SECRET_KEY=change-me
SESSION_COOKIE_NAME=forklift_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Database connection (persisted in ./data when using Docker)
DATABASE_URL=sqlite:////app/data/forklift.db

# SAML service provider configuration
SAML_BASE_URL=https://verify.example.asu.edu
SAML_ENTITY_ID=https://verify.example.asu.edu/saml/metadata
SAML_ACS_URL=https://verify.example.asu.edu/auth/saml/acs
SAML_SLS_URL=https://verify.example.asu.edu/auth/saml/slo
SAML_CERT_FILE=certs/sp.crt
SAML_KEY_FILE=certs/sp.key
SAML_IDP_METADATA=/app/data/idp-metadata.xml
SAML_METADATA_PATH=/app/data/sp-metadata.xml
SAML_METADATA_VALIDITY_DAYS=365
SAML_ATTR_ASURITE=uid,asuEduID,asuEduPersonID
SAML_ATTR_EMAIL=mail,email
SAML_ATTR_FULL_NAME=displayName
SAML_ATTR_FIRST_NAME=givenName
SAML_ATTR_LAST_NAME=sn
SAML_ATTR_AFFILIATIONS=eduPersonAffiliation

# Discord OAuth and bot configuration
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
DISCORD_REDIRECT_URI=https://verify.example.asu.edu/auth/discord/callback
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_GUILD_ID=your-guild-id
DISCORD_VERIFIED_ROLE_ID=your-verified-role-id
DISCORD_SCOPE="identify guilds.join"
DISCORD_SUCCESS_REDIRECT=/verified
DISCORD_FAILURE_REDIRECT=/verification-error
QNA_FORUM_CHANNEL_ID=your-forum-channel-id
QNA_KNOWLEDGE_BASE_ID=your-knowledge-base-id
QNA_MODEL_ARN=us.anthropic.claude-3-5-sonnet-20241022-v2:0
QNA_AWS_REGION=us-west-2
QNA_HELPER_ROLE_ID=your-helper-role-id
